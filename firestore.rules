rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins are named by Firebase Auth user id. Sign-up is turned off in the
    // console, but rules never trust "signed in" alone (security fix, Nov 27, 2026).
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['fkAiz6xRifPRnQU64SNAHkjrmbq1']; // scott@biggerpocketsmoney.com
    }

    // Resources: public read; only admins change them, except the public download counter.
    match /resources/{resource} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount'])
            && request.resource.data.downloadCount is int
            && request.resource.data.downloadCount == resource.data.get('downloadCount', 0) + 1);
    }

    // Leads: anyone may submit the form; only admins read or change them.
    match /leads/{lead} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
